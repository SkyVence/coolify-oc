{
  "name": "coolify-oc-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun run typecheck && bun run test",
    "build": "bun run --cwd packages/server build"
  },
  "devDependencies": {
    "@opencode/client": "^2.0.13",
    "@opencode/plugin": "2.0.13",
    "@opencode/schema": "2.0.13",
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "@types/node": "^26.6.2",
    "solid-js": "^1.9.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
