{
  "name": "@skyvence/coolify-oc",
  "version": "0.1.1",
  "description": "Deploy and configure projects on a self-hosted Coolify instance from OpenCode, with a TUI panel and model-facing tools.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "coolify",
    "deploy",
    "paas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkyVence/coolify-oc.git"
  },
  "homepage": "https://github.com/SkyVence/coolify-oc#readme",
  "bugs": {
    "url": "https://github.com/SkyVence/coolify-oc/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun run typecheck && bun run test",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.13"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "^2.0.13",
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "@types/node": "^26.6.2",
    "solid-js": "^1.9.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
